    "static-analysis",
    "security",
    "reliability",
    "mcp"
  ],
  "homepage": "https://trustabl.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustabl/ai-sdk-tool.git"
  },
